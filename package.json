{
  "name": "java-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:legacy": "node --test \"src/tests/*.test.mjs\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run lint --if-present && npm run build && npm test && npm run test:e2e",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "oxlint": "^1.79.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
